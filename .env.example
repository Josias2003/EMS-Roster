# Copy this file to .env and adjust for your environment.
# .env is gitignored — never commit real credentials.

# Port 3307 here matches docker-compose.yml's host mapping (3306 is often
# already taken by a native MySQL install). Inside docker-compose itself,
# the app container talks to the mysql container over the internal network at
# mysql:3306, not this URL.
DATABASE_URL=mysql+pymysql://ems:ems@localhost:3307/ems_roster

# Signs login tokens. Generate a real one for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me

# Set to "production" (or anything other than "development") on a real
# deploy — the app then REFUSES to start if JWT_SECRET isn't also set to a
# real value, instead of silently signing tokens with the placeholder above.
ENVIRONMENT=development
