# Copy to .env.production on the server and fill in. NEVER commit the real file
# (.gitignore already excludes .env.*).
#
# Generate each secret with:  openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=

# Your public hostname, no https:// (e.g. samu-roster.duckdns.org)
SITE_ADDRESS=

# Optional solver tuning (defaults shown)
# MEDICAL_SOLVE_SECONDS=300
# DRIVER_SOLVE_SECONDS=90
# SOLVER_WORKERS=4
